{
  "name": "__NAME__",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "native": "node scripts/native.mjs",
    "sync": "node scripts/native.mjs && vite build && cap sync",
    "sync:ios": "node scripts/native.mjs && vite build && cap sync ios",
    "sync:android": "node scripts/native.mjs && vite build && cap sync android",
    "ios": "npm run sync:ios && cap open ios",
    "android": "npm run sync:android && cap open android",
    "icons": "capacitor-assets generate --ios --android --iconBackgroundColor '#ffffff' --splashBackgroundColor '#ffffff'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "bootstrap": "^5.3.9",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.8"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
