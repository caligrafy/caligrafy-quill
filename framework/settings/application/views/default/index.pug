extends master/site

block content
  section.cq-hero
    if $authorized
      h1.cq-display You are signed in
    else
      h1.cq-display Welcome to Caligrafy
    p.cq-lead Build each feature once, and use it from a web page, a phone, a REST API and AI agents.
    .cq-cta
      a.btn.btn-primary(href="https://github.com/caligrafy/caligrafy-quill/wiki", target="_blank", rel="noopener") Read the docs
      a.btn.btn-secondary(href="https://youtube.com/playlist?list=PLsJG81fLk3_VWmXl9DnEldYY9ei4jTCjA", target="_blank", rel="noopener") Watch the tutorials

  section.cq-band
    .cq-inner
      .cq-tiles
        a.cq-tile(href="https://github.com/caligrafy/caligrafy-quill/wiki", target="_blank", rel="noopener")
          h3 Docs and cookbook
          p The ins and outs of Caligrafy Quill.
          span.cq-tile-link Read the docs ›
        a.cq-tile(href="https://github.com/caligrafy/caligrafy-quill-course/wiki", target="_blank", rel="noopener")
          h3 The course
          p A complete application, from zero to online.
          span.cq-tile-link Start the course ›
        a.cq-tile(href="https://youtube.com/playlist?list=PLsJG81fLk3_VWmXl9DnEldYY9ei4jTCjA", target="_blank", rel="noopener")
          h3 Caligrafy channel
          p Video tutorials for powerful, sophisticated features.
          span.cq-tile-link Watch ›
        a.cq-tile(href="https://caligrafy.slack.com/", target="_blank", rel="noopener")
          h3 The community
          p Questions, answers and what people build.
          span.cq-tile-link Join on Slack ›
        a.cq-tile(href="https://github.com/sponsors/DoryAzar", target="_blank", rel="noopener")
          h3 Keep Caligrafy going
          p Contributions keep our commitments to developers.
          span.cq-tile-link Sponsor ›
        a.cq-tile(href="https://github.com/caligrafy/caligrafy-quill", target="_blank", rel="noopener")
          h3 The code
          p Caligrafy Quill on GitHub.
          span.cq-tile-link View on GitHub ›
