//- A message above a form, for pages of the older masters (layout.pug, layoutblocks.pug); pages of site.pug use
//- modules/notice. $status (danger, success, info), $message_header, $message. look.css gives .alert Caligrafy's look.
div.alert.cq-alert(class=($status == 'danger' ? 'alert-danger cq-alert--error' : 'alert-' . $status), role="alert")
    span.visually-hidden= $status
    if $message_header
        strong= $message_header
        br
    = $message
