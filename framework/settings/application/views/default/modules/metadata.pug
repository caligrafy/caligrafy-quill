//- The social card of every page: what Facebook, LinkedIn, X, Slack, iMessage... show when its address is shared.
//- From metadata() in application/config/config.php (or the 'metadata' a controller passes to its view): title,
//- description, image (1200x630), image_alt, site_name, site_url (APP_URL by default). Nothing is printed before a title.
- $card = !empty($metadata) ? (array) $metadata : (array) metadata()
if !empty($card['title'])
  - $cardBase = rtrim((string) ($card['site_url'] ?? (getenv('APP_URL') ?: '')), '/')
  - $cardUrl = $cardBase !== '' ? $cardBase . strtok($_SERVER['REQUEST_URI'] ?? '/', '?') : ''
  - $cardImage = $card['image'] ?? ''
  if !empty($card['description'])
    meta(name="description", content=$card['description'])/
  meta(property="og:type", content="website")/
  if !empty($card['site_name'])
    meta(property="og:site_name", content=$card['site_name'])/
  meta(property="og:title", content=$card['title'])/
  if !empty($card['description'])
    meta(property="og:description", content=$card['description'])/
  if $cardUrl
    meta(property="og:url", content=$cardUrl)/
  if $cardImage
    meta(property="og:image", content=$cardImage)/
    meta(property="og:image:width", content=$card['image_width'] ?? '1200')/
    meta(property="og:image:height", content=$card['image_height'] ?? '630')/
    if !empty($card['image_alt'])
      meta(property="og:image:alt", content=$card['image_alt'])/
  meta(name="twitter:card", content=$cardImage ? 'summary_large_image' : 'summary')/
  meta(name="twitter:title", content=$card['title'])/
  if !empty($card['description'])
    meta(name="twitter:description", content=$card['description'])/
  if $cardImage
    meta(name="twitter:image", content=$cardImage)/
    if !empty($card['image_alt'])
      meta(name="twitter:image:alt", content=$card['image_alt'])/
