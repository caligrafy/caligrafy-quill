extends ../master/layoutblocks
- $home = session('home');

block additional_css
    link(rel="stylesheet", href=session('cssUrl').'stripe_global.css')

block content
    .spacer-4
    .content-section.equally-spaced-1
        //- The controller passes the Checkout Session url ($result['url']): Stripe hosts the whole payment page
        if !empty($checkoutUrl)
            .horizontal-center
                a#checkout-button(href=$checkoutUrl)
                    .textcolor0.medium-text Check out
        else
            p.horizontal-center The checkout session could not be created.
