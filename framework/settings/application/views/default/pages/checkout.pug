extends ../master/layoutblocks
- $home = session('home');

//- Stripe Checkout: the controller passes the Checkout Session url ($result['url']) as $checkoutUrl; Stripe hosts the payment page

block content
    main.cq-page
        .cq-card
            .cq-card-head
                h2.cq-title Checkout
                p.cq-note You pay on a page hosted by Stripe.
            .cq-section
                if !empty($checkoutUrl)
                    a#checkout-button.btn.btn-primary.cq-submit(href=$checkoutUrl) Check out
                else
                    p.cq-error(role='alert') The checkout session could not be created.
