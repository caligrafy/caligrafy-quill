extends ../default/master/site

block title
  | Team members · Caligrafy

block nav_links
  a.cq-nav-link.is-active(href="{$home}users") Team
  a.cq-nav-link(href="{$home}logout") Sign out

block content
  section.cq-hero.cq-hero--page
    h1.cq-display Team members
    p.cq-lead= count($users) . (count($users) == 1 ? ' person' : ' people') . '. Open one to change their name, password or level.'
  section.cq-band.cq-band--tight
    .cq-inner.cq-inner--narrow
      ul.cq-rows
        each $user in $users
          li.cq-row
            .cq-row-main
              p.cq-row-title
                a(href="{$home}users/{$user->id}/edit")= $user->username
              p.cq-row-meta= 'Updated ' . $user->modified_at
            .cq-row-actions
              span(class="cq-badge" . ($user->permissions > 0 ? ' cq-badge--strong' : ''), title="Level")= 'Level ' . $user->permissions
              a.btn.btn-secondary(href="{$home}users/{$user->id}/edit") Edit
