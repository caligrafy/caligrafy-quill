extends ../default/master/site

block title
  | Team member · Caligrafy

block nav_links
  a.cq-nav-link.is-active(href="{$home}users") Team
  a.cq-nav-link(href="{$home}logout") Sign out

block content
  - $userId = $user->id?? '';
  main.cq-auth
    a.cq-back(href="{$home}users") ‹ Team members
    h1= $user->username ?? 'Team member'
    include ../default/modules/notice
    form#user_new_form(method='POST', enctype="multipart/form-data")
      if $put
        =methodField('PUT')
      =csrf()
      .cq-field
        label(for='username') Username
        input#username.form-control(type='text', name='username', value=$user->username?? '', required, autocapitalize='none', maxlength='100')
        if isset($errors['username'])
          p.cq-field-error= $errors['username']
      .cq-field
        label(for='passcode') New password #{$put ? '(optional)' : ''}
        input#passcode.form-control(type='password', name='passcode', autocomplete='new-password', maxlength='72', required=!$put)
        if isset($errors['passcode'])
          p.cq-field-error= $errors['passcode']
      .cq-field
        label(for='confirmpasscode') Confirm the new password
        input#confirmpasscode.form-control(type='password', name='confirmpasscode', autocomplete='new-password', maxlength='72', required=!$put)
      .cq-field
        label(for='permissions') Level
        input#permissions.form-control(type='number', name='permissions', value=$user->permissions?? 0, min='0')
        if isset($errors['permissions'])
          p.cq-field-error= $errors['permissions']
      button.btn.btn-primary(type='submit') Save
    if $put
      form#user_delete_form(method='POST', enctype="multipart/form-data")
        =methodField('DELETE')
        =csrf()
        .cq-or Or
        button.btn.btn-secondary.cq-btn-block(type='submit') Delete this person
