extends ../default/master/site

block title
  | Create account · Caligrafy

block content
  main.cq-auth
    h1 Create account
    p.cq-lead Letters and digits for the username, at least 8 characters for the password.
    include ../default/modules/notice
    form#user_new_form(method='POST', enctype="multipart/form-data")
      =csrf()
      .cq-field
        label(for='username') Username
        input#username.form-control(type='text', name='username', value=$user->username?? '', required, autocomplete='username', autocapitalize='none', maxlength='100')
        if isset($errors['username'])
          p.cq-field-error= $errors['username']
      .cq-field
        label(for='passcode') Password
        input#passcode.form-control(type='password', name='passcode', required, autocomplete='new-password', maxlength='72')
        if isset($errors['passcode'])
          p.cq-field-error= $errors['passcode']
      .cq-field
        label(for='confirmpasscode') Confirm password
        input#confirmpasscode.form-control(type='password', name='confirmpasscode', required, autocomplete='new-password', maxlength='72')
      button.btn.btn-primary(type='submit') Create account
    .cq-or Or
    a.btn.btn-secondary.cq-btn-block(href="{$home}login") Sign in
