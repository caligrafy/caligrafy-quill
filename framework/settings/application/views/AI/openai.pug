extends ../default/master/site

//- OpenAI: text (analyze, summarize, complete...) or an image, from a prompt (AIController)

block title
  | OpenAI · Caligrafy

block content
  main.cq-auth.cq-auth--wide
    h1 OpenAI
    p.cq-lead Ask for text or an image. The request goes from the server: the key never reaches the page.
    include ../default/modules/notice
    form#ai_form(method='POST', enctype="multipart/form-data")
      =csrf()
      .cq-form-grid.cq-form-grid--2
        .cq-field
          label(for='type') Type
          select#type.form-select(name="type")
            option(value="TEXT", selected=isset($parameters['type'])&&$parameters['type']=='TEXT') Text
            option(value="IMAGE", selected=isset($parameters['type'])&&$parameters['type']=='IMAGE') Image
          if isset($errors['type'])
            p.cq-field-error= $errors['type']
        .cq-field
          label(for='command') Command
          select#command.form-select(name="command")
            each $label, $value in array('ANALYZE' => 'Analyze', 'SUMMARIZE' => 'Summarize', 'COMPLETE' => 'Complete', 'CORRECT' => 'Correct', 'CLASSIFY' => 'Classify', 'CONVERSE' => 'Converse', 'PREDICT' => 'Predict', 'RECOMMEND' => 'Recommend')
              option(value=$value, selected=isset($parameters['command'])&&$parameters['command']==$value)= $label
          if isset($errors['command'])
            p.cq-field-error= $errors['command']
      .cq-field
        label(for='input') Input
        textarea#input.form-control(name="input", maxlength="4000", rows="8", placeholder="What would you like the machine to know?", required)= isset($parameters['input'])? $parameters['input'] : ''
        if isset($errors['input'])
          p.cq-field-error= $errors['input']
      .cq-field
        label(for='outcome') Outcome (optional)
        textarea#outcome.form-control(name="outcome", maxlength="4000", rows="4", placeholder="What you would like the machine to give you")= isset($parameters['outcome'])? $parameters['outcome'] : ''
        if isset($errors['outcome'])
          p.cq-field-error= $errors['outcome']
      button.btn.btn-primary(type='submit') Submit

    if !empty($response)
      section.cq-stack.cq-response
        h2.cq-heading Response
        each $item in $response['response']
          if isset($item['message']['content'])
            p= $item['message']['content']
          else if isset($item['b64_json'])
            img.img-fluid(src="data:image/png;base64," . $item['b64_json'], alt="Generated image")
          else if isset($item['url'])
            p
              a(href=$item['url']) View the generated image
          else if !empty($item['message'])
            p.cq-alert.cq-alert--error= 'The AI could not give a response: ' . $item['message']
