APP_ENV=local
APP_PROTOCOL=http
APP_DEBUG=true
# LEGACY_API_KEY: false accepts only personal access tokens, see php caligrafer.php token; true keeps the old shared key
LEGACY_API_KEY=true
# TOKEN_DEFAULT_SCOPES: empty means a token calls a write capability declared without a scope only with the scope named after it,
# such as create_book, or *. false, deprecated and only for the move to 2.26.0, lets any token call it as before
TOKEN_DEFAULT_SCOPES=
# STRICT_RELATIONS: empty means in development a relation method run on one of several models a query read throws ERROR 2004,
# one query per row: load the relation with with. false logs a warning instead, as production always does
STRICT_RELATIONS=

FAVICON=resources/favicon.ico
# PWA_SERVICE_WORKER: true registers public/sw.js, an offline page when there is no network; it never caches pages, API or POST
PWA_SERVICE_WORKER=false
# DESIGN_STYLE: empty = Caligrafy's own look. A style of framework/design or application/design (php caligrafer.php design list) restyles every page
# with public/css/designs/<name>.css, written from its DESIGN.md by /caligrafy-quill:design in Claude Code
DESIGN_STYLE=

APP_LOCALE=en_US
SERVER_TIMEZONE=America/New_York
SANDBOX_SERVER=
SANDBOX_PORT=

DB_ACTIVATE=false
DB_CONNECTION=mysql
DB_HOST=localhost  # use 'mysql' for Docker
DB_PORT=3306
DB_DATABASE=databasename
DB_USERNAME=root
DB_PASSWORD=root
# DB_TIMEZONE: empty means MySQL uses SERVER_TIMEZONE like PHP, one clock for the database and the audit log. server keeps the MySQL time zone
DB_TIMEZONE=
# DB_TEST_DATABASE: the database of php caligrafer.php test, empty means DB_DATABASE, each test is rolled back
DB_TEST_DATABASE=
# DB_PERSISTENT: empty or true keeps the MySQL or PostgreSQL connection of each web server process between requests, rolled back and reset first; false connects on every request
DB_PERSISTENT=
# PHP_PROCESSES: PHP processes of the production image; empty means 2 per CPU and at least 4, or 6 per CPU and at least 16 when an AI key is set
PHP_PROCESSES=
# KEEP_ALIVE: empty or off closes each connection after its answer, the proxy in front keeps the visitors connected; on keeps them open
KEEP_ALIVE=
# CACHE: empty or on lets the production image keep public answers in memory, a capability or page declared with cache; off turns that cache off
CACHE=
# PRELOAD: empty or on compiles the classes of the framework into memory when the production image starts, off turns it off
PRELOAD=
# ASYNC: on, experimental and after php caligrafer.php add async, answers the capabilities channel from processes that keep the app in memory, in front of Apache; ASYNC_WORKERS: their number, empty means one per CPU
ASYNC=
ASYNC_WORKERS=
# CACHE_STORE: where the cache keeps values, empty means database when there is one and file otherwise, off keeps nothing
CACHE_STORE=

# APP_URL: the address of the app, such as https://myapp.example.com, for the links of emails sent by jobs or the command line
APP_URL=

MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-user-name
MAIL_PASSWORD=your-password
# MAIL_FROM: the sender of the emails; empty = MAIL_USERNAME when it is an address
MAIL_FROM=

# Notifications, Caligrafy Notify: the channels offered, at most this many messages per user and hour, and the web push
# keys that php caligrafer.php notify keys writes. New keys cut off every browser that turned push on
NOTIFY_CHANNELS=push,email
NOTIFY_RATE_PER_HOUR=30
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

PAY_PUBLIC_KEY_TEST=pk_test_1234
PAY_PRIVATE_KEY_TEST=sk_test_1234
PAY_PUBLIC_KEY_PRODUCTION=pk_live_1234
PAY_PRIVATE_KEY_PRODUCTION=sk_live_1234

WATSON_API_KEY=
WATSON_URL= # https://api.<region>.assistant.watson.cloud.ibm.com/instances/<instance_id>
WATSON_ENVIRONMENT_ID=
WATSON_API_VERSION=2024-08-25

COINBASE_API_KEY_NAME= # Coinbase Business, CDP key: organizations/<org_id>/apiKeys/<key_id>
COINBASE_API_KEY_SECRET=

FB_APP_ID=1234

GOOGLE_ANALYTICS_ID=

OPEN_AI_KEY=
OPEN_AI_MODEL= # optional, default gpt-6-luna
OPEN_AI_IMAGE_MODEL= # optional, default gpt-image-2

GROQ_API_KEY=
GROQ_MODEL= # optional, default openai/gpt-oss-120b
GROQ_VISION_MODEL= # optional, default qwen/qwen3.8-27b

# Agent provider of Caligrafy Agent: groq by default, together, fireworks, openrouter, ollama or custom
AGENT_PROVIDER= # optional, default groq
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
AGENT_API_KEY= # optional, used when the provider key above is empty, custom endpoints
AGENT_API_BASE= # optional endpoint; required for custom. Ollama default http://localhost:11434/v1, from Docker: http://host.docker.internal:11434/v1
AGENT_MODEL= # optional, default per provider, openrouter meta-llama/llama-3.3-70b-instruct, ollama llama3.2
AGENT_VISION_MODEL= # optional, default per provider

# The assistant of Snap Cards, Route::snap since 2.23.0: Claude reads what people type and answers with cards.
# Without a key it answers from the names of the cards and the shortcuts. A key: console.anthropic.com, API keys
ANTHROPIC_API_KEY=
SNAP_MODEL= # optional, default claude-opus-5-5
SNAP_EFFORT= # optional, default low: low, medium or high

APPROVED_AGENTS= # separate by commas without spaces
