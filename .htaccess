<IfModule mod_rewrite.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "POST, GET, OPTIONS, DELETE, PUT"
    Header set Access-Control-Allow-Headers "*"
    Header always edit Set-Cookie ^(.*)$ $1;HttpOnly;Secure;SameSite=none
    RewriteEngine On

    #RewriteBase /mvc

    # Never serve server-side files: dotfiles (.env, .git, .claude...), the server-side folders and the tooling files.
    # Only existing files and folders are denied, so routes that happen to use these names keep working.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(application|framework|vendor|tests|qa|docker|claude-plugin|archives|node_modules)(/|$) - [NC,F,L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(caligrafer\.php|composer\.(json|lock)|docker-compose\.ya?ml|package(-lock)?\.json)$ - [NC,F,L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule \.(sql|log|bak|ini|sh|env)$ - [NC,F,L]

    # Web app manifest and service worker (public/manifest.webmanifest, public/sw.js): the service worker lives in
    # public/ but controls the whole application, so it is allowed the scope of the site.
    RewriteRule ^public/sw\.js$ - [E=CALIGRAFY_SW:1]
    Header set Service-Worker-Allowed "/" env=CALIGRAFY_SW

    # Handle Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.+)$ index.php?uri=$1 [L,QSA]
    
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
