#!/bin/bash

# Preparing input
if [ "$1" ]; then
    MODE="$(tr [A-Z] [a-z] <<< "$1")"
else
    # use random value to trigger help
    MODE="help"
fi
if [ "$2" ]; then
    COMMAND="$(tr [A-Z] [a-z] <<< "$2")"
else
    # use random value to trigger help
    COMMAND=""
fi

# quickstart: a fresh project to a working application with Docker only (no PHP or Composer needed on this computer)
if [ "$MODE" = "quickstart" ]; then
    cd "$(dirname "$0")/.." || exit 1
    COMPOSE="docker compose"
    $COMPOSE version >/dev/null 2>&1 || COMPOSE="docker-compose"
    if ! docker info >/dev/null 2>&1; then
        printf "\nDocker is not running: start Docker Desktop, then run .bin/caligrafer quickstart again.\n\n"; exit 1
    fi
    if [ -d .git ] && [ ! -d application ] && [[ " $* " != *" --yes "* ]]; then
        printf "\nquickstart initializes the project, which deletes the .git folder of the framework (your project starts its own history).\n"
        read -r -p "Continue? [y/N] " ANSWER
        [ "$ANSWER" = "y" ] || [ "$ANSWER" = "Y" ] || exit 1
        set -- "$@" --yes
    fi
    if [ ! -f vendor/autoload.php ]; then
        printf "\nInstalling the PHP libraries (Composer in Docker)...\n"
        if command -v composer >/dev/null 2>&1; then composer install --no-interaction || exit 1
        else docker run --rm -v "$PWD":/app -w /app composer:2 install --no-interaction --ignore-platform-reqs || exit 1; fi
    fi
    [ -f .env ] || cp framework/settings/.env.example .env
    printf "\nStarting the server (the first start builds the PHP image: a few minutes)...\n"
    $COMPOSE up -d dev-box || exit 1
    $COMPOSE exec -T dev-box php caligrafer.php quickstart "${@:2}"
    exit $?
fi

# Calling the right service based on PHP and Composer presence

printf "Checking if server is running..."
if pgrep -x "httpd" > /dev/null; then
    SERVER=""
else
    SERVER="off"
fi

printf "Checking PHP and composer..."
php --version && composer --version
if  [ $? -eq 0 ]; then
    if [ "$MODE" = "version" ] || [ "$MODE" = "--version" ] || [ "$MODE" = "-v" ]; then
        ./caligrafer.php version; exit $?
    elif [ "$MODE" = "doctor" ]; then
        # read-only: never initializes or installs anything; options are passed as typed
        if [ -d "./vendor" ]; then ./caligrafer.php doctor "${@:2}"; exit $?; fi
        printf "\n\nFAIL vendor/ is missing: run composer install first\n\n"; exit 1
    elif [ -d "./vendor" ] && [ -f "./.env" ] &&  [ -d "./application" ] && [ "$MODE" = "upgrade" ]; then
        # upgrade options are passed as typed (--force takes a case-sensitive path)
        ./caligrafer.php upgrade "${@:2}"
    elif [ -d "./vendor" ] && [ -f "./.env" ] &&  [ -d "./application" ]; then
        ./caligrafer.php $MODE $COMMAND $SERVER
    elif [ -d "./vendor" ]; then
        printf "\n\nCaligrafy needs to be initialized first\n\n"
        ./caligrafer.php initialize $SERVER || exit 1
        if [ $MODE != "initialize" ]; then
            ./caligrafer.php $MODE $COMMAND $SERVER
        fi
    else
        printf "\n\nIt seems that you have downloaded Caligrafy directly from Github.\nLet's get the dependencies first...\n\n"
        composer install
        ./caligrafer.php initialize $SERVER || exit 1

        if [ $MODE != "initialize" ]; then
            ./caligrafer.php $MODE $COMMAND $SERVER
        fi
    fi
else
    ./.bin/server $COMMAND
fi