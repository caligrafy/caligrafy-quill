#!/bin/bash

# Registers this project's Claude Code plugin with the claude command of this computer (quickstart in Docker: the
# container has no claude). php caligrafer.php plugin does the same where PHP runs on the computer
connectPlugin() {
    command -v claude >/dev/null 2>&1 || return 0
    local NAME
    NAME=$(sed -n 's/^ *"name": *"\([^"]*\)".*/\1/p' .claude-plugin/marketplace.json 2>/dev/null | head -1)
    [ -n "$NAME" ] && [ "$NAME" != "caligrafy" ] || return 0
    claude plugin marketplace list 2>/dev/null | grep -q "$NAME" || claude plugin marketplace add "$PWD" >/dev/null 2>&1
    claude plugin list 2>/dev/null | grep -q "caligrafy-quill@$NAME" || claude plugin install "caligrafy-quill@$NAME" --scope project >/dev/null 2>&1
    printf "\nClaude Code plugin: caligrafy-quill@%s, read from this folder (restart claude here to load it)\n" "$NAME"
}

# Preparing input
if [ "$1" ]; then
    MODE="$(tr [A-Z] [a-z] <<< "$1")"
else
    # use random value to trigger help
    MODE="help"
fi
if [ "$2" ]; then
    COMMAND="$(tr [A-Z] [a-z] <<< "$2")"
else
    # use random value to trigger help
    COMMAND=""
fi

# a local web server (MAMP, XAMPP: httpd; LAMP on Debian and Ubuntu: apache2) is running
localServerRunning() { pgrep -x httpd >/dev/null 2>&1 || pgrep -x apache2 >/dev/null 2>&1; }

# quickstart: a fresh project to a working application, on the local server (MAMP, XAMPP, LAMP) when one is running
# and PHP is installed, else on Docker (no PHP or Composer needed). --local or --docker chooses.
if [ "$MODE" = "quickstart" ]; then
    cd "$(dirname "$0")/.." || exit 1
    COMPOSE="docker compose"
    $COMPOSE version >/dev/null 2>&1 || COMPOSE="docker-compose"
    WHERE=""
    [[ " $* " == *" --docker "* ]] && WHERE="docker"
    [[ " $* " == *" --local "* ]] && WHERE="local"
    if [ -z "$WHERE" ]; then
        if localServerRunning && command -v php >/dev/null 2>&1; then WHERE="local"
        elif docker info >/dev/null 2>&1; then WHERE="docker"
        else
            printf "\nNo server to run Caligrafy: start MAMP, XAMPP or your Apache and MySQL (LAMP), or Docker Desktop,\nthen run .bin/caligrafer quickstart again (--local or --docker chooses).\n\n"; exit 1
        fi
    fi
    if [ -d .git ] && [ ! -d application ] && [[ " $* " != *" --yes "* ]]; then
        printf "\nquickstart initializes the project, which deletes the .git folder of the framework (your project starts its own history).\n"
        read -r -p "Continue? [y/N] " ANSWER
        [ "$ANSWER" = "y" ] || [ "$ANSWER" = "Y" ] || exit 1
        set -- "$@" --yes
    fi
    if [ "$WHERE" = "local" ]; then
        if ! command -v php >/dev/null 2>&1; then
            printf "\nPHP is not installed on this computer: use Docker (.bin/caligrafer quickstart --docker).\n\n"; exit 1
        fi
        printf "\nUsing the local server (MAMP, XAMPP or LAMP). Docker instead: .bin/caligrafer quickstart --docker\n"
        if [ ! -f vendor/autoload.php ]; then
            command -v composer >/dev/null 2>&1 || { printf "\nComposer is not installed: https://getcomposer.org, or use Docker (--docker).\n\n"; exit 1; }
            composer install --no-interaction || exit 1
        fi
        php caligrafer.php quickstart "${@:2}" || exit $?
        php caligrafer.php plugin
        exit 0
    fi
    if ! docker info >/dev/null 2>&1; then
        printf "\nDocker is not running: start Docker Desktop, then run .bin/caligrafer quickstart again.\n\n"; exit 1
    fi
    if [ ! -f vendor/autoload.php ]; then
        printf "\nInstalling the PHP libraries (Composer in Docker)...\n"
        if command -v composer >/dev/null 2>&1; then composer install --no-interaction || exit 1
        else docker run --rm -v "$PWD":/app -w /app composer:2 install --no-interaction --ignore-platform-reqs || exit 1; fi
    fi
    [ -f .env ] || cp framework/settings/.env.example .env
    printf "\nStarting the server (the first start builds the PHP image: a few minutes)...\n"
    $COMPOSE up -d dev-box || exit 1
    $COMPOSE exec -T dev-box php caligrafer.php quickstart "${@:2}" || exit $?
    connectPlugin
    exit 0
fi

# Calling the right service based on PHP and Composer presence

# initialize and server read a last word that says whether a local server is running (off: Docker serves the project);
# every other command gets its arguments exactly as typed (design use linear.app, cloud deploy myapp, token create ...)
run_caligrafer() {
    case "$MODE" in
        initialize|server) ./caligrafer.php $MODE $COMMAND $SERVER ;;
        *) ./caligrafer.php "$MODE" "${@:2}" ;;
    esac
}

printf "Checking if server is running..."
if localServerRunning; then
    SERVER=""
else
    SERVER="off"
fi

printf "Checking PHP and composer..."
php --version && composer --version
if  [ $? -eq 0 ]; then
    if [ "$MODE" = "version" ] || [ "$MODE" = "--version" ] || [ "$MODE" = "-v" ]; then
        ./caligrafer.php version; exit $?
    elif [ "$MODE" = "doctor" ]; then
        # read-only: never initializes or installs anything; options are passed as typed
        if [ -d "./vendor" ]; then ./caligrafer.php doctor "${@:2}"; exit $?; fi
        printf "\n\nFAIL vendor/ is missing: run composer install first\n\n"; exit 1
    elif [ -d "./vendor" ] && [ "$MODE" = "update" ]; then
        # update options are passed as typed (a version, --check, --yes, --no-composer)
        ./caligrafer.php update "${@:2}"; exit $?
    elif [ -d "./vendor" ] && [ -f "./.env" ] &&  [ -d "./application" ] && [ "$MODE" = "upgrade" ]; then
        # upgrade options are passed as typed (--force takes a case-sensitive path)
        ./caligrafer.php upgrade "${@:2}"
    elif [ -d "./vendor" ] && [ -f "./.env" ] &&  [ -d "./application" ]; then
        run_caligrafer "$@"
    elif [ "$MODE" = "initialize" ]; then
        # initialize asks before deleting a .git folder (initialize --yes deletes it without asking)
        [ -d "./vendor" ] || composer install || exit 1
        ./caligrafer.php initialize $SERVER "${@:2}" || exit 1
    else
        # never initialize on the way to another command: initialize deletes the .git folder of the framework
        printf "\n\nThis folder is not a Caligrafy project yet (no application/ or .env): start it with .bin/caligrafer quickstart\n\n"
        exit 1
    fi
else
    ./.bin/server $COMMAND
fi