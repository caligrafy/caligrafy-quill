{
    "name": "caligrafy/caligrafy-quill",
    "description": "Build once, experience everywhere: a PHP MVC framework that serves one capability to web pages, Vue apps, REST APIs and AI agents (MCP)",
    "keywords": [
        "php",
        "vuejs",
        "framework",
        "mvc",
        "laravel",
        "light",
        "model",
        "view",
        "controller",
        "ai",
        "bot",
        "payment",
        "cryptocurrency",
        "mcp",
        "ai-agents",
        "build-once"
    ],
    "type": "framework",
    "license": "MIT",
    "authors": [
        {
            "name": "Dory Azar",
            "email": "dory.azar@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "pug-php/pug": "^3.6",
        "phug/phug": "^2.0",
        "vlucas/phpdotenv": "^5.8",
        "wixel/gump": "^2.3",
        "claviska/simpleimage": "^4.4",
        "stripe/stripe-php": "^22.0",
        "phpmailer/phpmailer": "^7.1",
        "lucianotonet/groq-php": "^1.4",
        "lbuchs/webauthn": "^2.2"
    },
    "config": {
        "allow-plugins": {
            "nodejs-php-fallback/nodejs-php-fallback": true
        }
    },
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^12"
    }
}
