<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="qa/unit/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <!-- the framework's own tests: tests/ holds an application's tests (php caligrafer.php test) -->
    <testsuites>
        <testsuite name="unit">
            <directory>qa/unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
